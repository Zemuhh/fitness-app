{
  "expo": {
    "name": "ERYA Pilates Reformer",
    "slug": "erya-pilates-reformer",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eryapilates",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E9",
    "ios": {
      "bundleIdentifier": "com.eryapilates.reformer",
      "buildNumber": "1",
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Salon QR kod girişi ve öğün fotoğrafı analizi için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Öğün fotoğrafı yükleme ve profil fotoğrafı seçimi için fotoğraf arşivi erişimi gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "QR giriş kartı ve antrenman görsellerini kaydetmek için fotoğraf arşivi izni gereklidir."
      }
    },
    "android": {
      "package": "com.eryapilates.reformer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "lang": "tr",
      "favicon": "./assets/images/favicon.png",
      "name": "FitClub Studio",
      "shortName": "FitClub",
      "display": "standalone",
      "orientation": "portrait",
      "backgroundColor": "#F4F7FB",
      "themeColor": "#0D9488"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Salon QR kod girişi ve öğün fotoğrafı analizi için kamera erişimi gereklidir.",
          "photosPermission": "Öğün fotoğrafı yükleme ve profil fotoğrafı seçimi için fotoğraf arşivi erişimi gereklidir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
